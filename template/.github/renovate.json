{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions",
    "npm",
    "pip",
    "dockerfile",
    "docker-compose"
  ],
  "ignoreUnstable": true,
  "age": {
    "maxDays": 7
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["vulnerability"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "matchDatasources": ["npm", "pypi", "docker"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group all updates together",
      "matchPackagePatterns": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "enabled": true
    }
  ],
  "prConcurrencyLimit": 10,
  "prPriority": 30,
  "timezone": "Etc/UTC",
  "schedule": ["after 10pm every weekday"],
  "rebaseWhen": "behind-base-branch",
  {% if renovate_level == 'minimal' %}
  "automerge": false,
  "automergeType": "pr",
  {% elif renovate_level == 'yolo' %}
  "automerge": true,
  "automergeType": "pr",
  {% else %}
  "automerge": true,
  "automergeType": "pr",
  "prPriority": 5,
  {% endif %}
  "labels": ["dependencies"],
  "assignees": [],
  "reviewers": [],
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersionSanitized}}}",
  "commitMessageTopic": "Update {{{depName}}} to {{{newVersion}}}",
  "prTitle": "Update {{{depName}}} to {{{newVersion}}}",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am every weekday"],
    {% if renovate_level == 'minimal' %}
    "automerge": false,
    {% else %}
    "automerge": true,
    "automergeType": "pr"
    {% endif %}
  },
  "rangeStrategy": "bump",
  "ignorePaths": [
    "node_modules/",
    "dist/",
    "build/",
    ".git/",
    ".github/renovate.json"
  ],
  "enabled": true
}
