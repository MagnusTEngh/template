{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions",
    "npm",
    "pip",
    "dockerfile",
    "docker-compose"
    {% if 'nix' in components %},
    "flake"
    {% endif %}
  ],
  "ignoreUnstable": true,
  "age": {
    "maxDays": 7
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["vulnerability"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "matchDatasources": ["npm", "pypi", "docker"{% if 'nix' in components %}, "nixpkgs"{% endif %}],
      "rangeStrategy": "bump"
    },
    {% if 'nix' in components %}
    {
      "description": "Nix flake updates",
      "matchManagers": ["flake"],
      "matchPackagePatterns": ["*"],
      "groupName": "nix dependencies",
      "groupSlug": "nix",
      "enabled": true,
      "rangeStrategy": "bump"
    },
    {% endif %}
    {% if 'python' in components %}
    {
      "description": "Python dependencies (uv/pip)",
      "matchManagers": ["pip"],
      "matchFileNames": ["pyproject.toml", "requirements.txt", "uv.lock"],
      "matchPackagePatterns": ["*"],
      "groupName": "python dependencies",
      "groupSlug": "python",
      "enabled": true,
      "rangeStrategy": "bump"
    },
    {% endif %}
    {
      "description": "Group all updates together",
      "matchPackagePatterns": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "enabled": true
    }
  ],
  "prConcurrencyLimit": 10,
  "prPriority": 30,
  "timezone": "Etc/UTC",
  "schedule": ["after 10pm every weekday"],
  "rebaseWhen": "behind-base-branch",
  {% if renovate_level == 'minimal' %}
  "automerge": false,
  "automergeType": "pr",
  {% elif renovate_level == 'yolo' %}
  "automerge": true,
  "automergeType": "pr",
  {% else %}
  "automerge": true,
  "automergeType": "pr",
  "prPriority": 5,
  {% endif %}
  "labels": ["dependencies"],
  "assignees": [],
  "reviewers": [],
{% raw %}
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersionSanitized}}}",
  "commitMessageTopic": "Update {{{depName}}} to {{{newVersion}}}",
  "prTitle": "Update {{{depName}}} to {{{newVersion}}}",
{% endraw %}
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am every weekday"],
    {%- if renovate_level == 'minimal' %}
    "automerge": false
    {%- else %}
    "automerge": true,
    "automergeType": "pr"
    {%- endif %}
  },
  "rangeStrategy": "bump",
  "ignorePaths": [
    "node_modules/",
    "dist/",
    "build/",
    ".git/",
    ".github/renovate.json"
  ],
  "enabled": true
}
